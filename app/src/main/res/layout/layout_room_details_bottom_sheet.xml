<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:paddingStart="20dp"
    android:paddingTop="12dp"
    android:paddingEnd="20dp"
    android:paddingBottom="24dp">

    <!-- Drag Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="#D1D5DB" />

    <!-- Building Header info -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="6dp">

        <TextView
            android:id="@+id/tv_bs_building_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            tools:text="Andrew Gonzalez Hall"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#111827" />

        <TextView
            android:id="@+id/tv_bs_building_code"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="ANDREW"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#005A36"
            android:background="@drawable/bg_chip_code"
            android:paddingStart="8dp"
            android:paddingTop="4dp"
            android:paddingEnd="8dp"
            android:paddingBottom="4dp" />

    </LinearLayout>

    <TextView
        android:id="@+id/tv_bs_building_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        tools:text="20-storey multi-purpose academic and administrative building."
        android:textSize="13sp"
        android:textColor="#6B7280"
        android:layout_marginBottom="16dp" />

    <!-- Floor Selector Title & Horizontal Floor List -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/floor_level"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#374151"
        android:layout_marginBottom="8dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_floor_selector"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        tools:listitem="@layout/item_floor_chip"
        android:clipToPadding="false"
        android:layout_marginBottom="16dp" />

    <!-- Filter Chips for Availability -->
    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chip_group_availability"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:singleSelection="true"
        app:selectionRequired="true"
        android:layout_marginBottom="12dp">

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_filter_all"
            style="@style/Widget.MaterialComponents.Chip.Choice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/filter_all"
            android:checked="true" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_filter_available"
            style="@style/Widget.MaterialComponents.Chip.Choice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/filter_available" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_filter_reserved"
            style="@style/Widget.MaterialComponents.Chip.Choice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/filter_reserved" />

    </com.google.android.material.chip.ChipGroup>

    <!-- Rooms List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_rooms"
        android:layout_width="match_parent"
        android:layout_height="260dp"
        tools:listitem="@layout/item_room" />

    <!-- Empty state -->
    <TextView
        android:id="@+id/tv_empty_rooms"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:gravity="center"
        android:text="No rooms found for this floor/filter."
        android:textSize="14sp"
        android:textColor="#9CA3AF"
        android:visibility="gone" />

</LinearLayout>