<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#005A36"
    tools:context=".ui.home.HomeActivity">

    <!-- Top Green Header Area -->
    <LinearLayout
        android:id="@+id/layout_home_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="24dp"
        android:paddingEnd="20dp"
        android:paddingBottom="20dp">

        <!-- User Info Row -->

        <!-- Quick Actions Title & Card (Outside white box, in green header) -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_home_avatar"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="14dp"
                app:cardBackgroundColor="#E5E7EB"
                app:cardCornerRadius="26dp"
                app:cardElevation="0dp"
                app:strokeColor="#005A36"
                app:strokeWidth="1.5dp">

                <ImageView
                    android:id="@+id/iv_home_avatar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Avatar"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_user_avatar" />

            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tv_greeting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_toEndOf="@id/card_home_avatar"
                android:fontFamily="sans-serif-medium"
                android:text="Hey there,\nFirst Name!"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_role_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/bg_badge_pill"
                android:fontFamily="sans-serif-medium"
                android:paddingStart="16dp"
                android:paddingTop="6dp"
                android:paddingEnd="16dp"
                android:paddingBottom="6dp"
                android:text="Student"
                android:textColor="#005A36"
                android:textSize="12sp"
                android:textStyle="bold" />

        </RelativeLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Quick Actions"
            android:textSize="20sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="10dp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardBackgroundColor="#FFFFFF"
            app:strokeWidth="0dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="false"
                android:gravity="center"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp">

                <!-- Quick Action 1: Edit Profile (All access) -->
                <LinearLayout
                    android:id="@+id/qa_edit_profile"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground"
                    android:padding="8dp">

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:src="@android:drawable/ic_menu_myplaces"
                        app:tint="#005A36"
                        android:contentDescription="Edit Profile" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Edit Profile"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="#1F2937"
                        android:layout_marginTop="6dp"
                        android:gravity="center" />

                </LinearLayout>

                <!-- Quick Action 2: View Map (All access) -->
                <LinearLayout
                    android:id="@+id/qa_view_map"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground"
                    android:padding="8dp">

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:src="@android:drawable/ic_dialog_map"
                        app:tint="#005A36"
                        android:contentDescription="View Map" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="View Map"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="#1F2937"
                        android:layout_marginTop="6dp"
                        android:gravity="center" />

                </LinearLayout>

                <!-- Quick Action 3: Notifications (Orgs and Faculty only) -->
                <LinearLayout
                    android:id="@+id/qa_notifications"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground"
                    android:padding="8dp"
                    android:visibility="visible">

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:src="@android:drawable/ic_popup_reminder"
                        app:tint="#005A36"
                        android:contentDescription="Notifications" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Notifications"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="#1F2937"
                        android:layout_marginTop="6dp"
                        android:gravity="center" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

    <!-- White Content Scroll Area -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/layout_home_header"
        android:layout_above="@+id/bottom_nav_bar"
        android:background="@drawable/bg_rounded_top_card"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- ADMIN EXECUTIVE COMMAND CENTER (ONLY VISIBLE FOR ADMINS) -->
            <LinearLayout
                android:id="@+id/layout_admin_home_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible"
                android:layout_marginBottom="20dp">

                <!-- Admin Executive Banner -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="16dp"
                    app:cardBackgroundColor="#005A36"
                    app:cardElevation="4dp"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <!-- Stat Badges Grid -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center"
                            android:layout_marginBottom="12dp">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:gravity="center"
                                android:background="@drawable/bg_floor_unselected"
                                android:padding="10dp"
                                android:layout_marginEnd="6dp">

                                <TextView
                                    android:id="@+id/tv_admin_home_pending_count"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    tools:text="2"
                                    android:textSize="20sp"
                                    android:textStyle="bold"
                                    android:textColor="#D97706" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Pending Req."
                                    android:textSize="10sp"
                                    android:textStyle="bold"
                                    android:textColor="#374151" />

                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:gravity="center"
                                android:background="@drawable/bg_floor_unselected"
                                android:padding="10dp"
                                android:layout_marginEnd="6dp">

                                <TextView
                                    android:id="@+id/tv_admin_home_approved_count"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    tools:text="1"
                                    android:textSize="20sp"
                                    android:textStyle="bold"
                                    android:textColor="#15803D" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Approved"
                                    android:textSize="10sp"
                                    android:textStyle="bold"
                                    android:textColor="#374151" />

                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:gravity="center"
                                android:background="@drawable/bg_floor_unselected"
                                android:padding="10dp">

                                <TextView
                                    android:id="@+id/tv_admin_home_buildings_count"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    tools:text="10"
                                    android:textSize="20sp"
                                    android:textStyle="bold"
                                    android:textColor="#005A36" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Buildings"
                                    android:textSize="10sp"
                                    android:textStyle="bold"
                                    android:textColor="#374151" />

                            </LinearLayout>

                        </LinearLayout>

                        <!-- Admin Action Shortcuts -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_admin_home_approvals"
                                style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                                android:layout_width="0dp"
                                android:layout_height="36dp"
                                android:layout_weight="1"
                                android:text="Approvals 📑"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:backgroundTint="#FFFFFF"
                                android:textColor="#005A36"
                                app:cornerRadius="18dp"
                                android:layout_marginEnd="6dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_admin_home_dashboard"
                                style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                                android:layout_width="0dp"
                                android:layout_height="36dp"
                                android:layout_weight="1"
                                android:text="All Bookings 📊"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:backgroundTint="#FFFFFF"
                                android:textColor="#005A36"
                                app:cornerRadius="18dp" />

                        </LinearLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- Admin Queue Section Header -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:text="Pending Approvals Queue"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#111827" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_admin_home_view_queue"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:text="Review All ➔"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#005A36" />

                </RelativeLayout>

                <!-- Pending Queue RecyclerView -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_admin_home_pending"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    tools:listitem="@layout/item_admin_reservation" />

                <TextView
                    android:id="@+id/tv_admin_home_empty_pending"
                    android:layout_width="match_parent"
                    android:layout_height="70dp"
                    android:gravity="center"
                    android:text="🎉 All pending reservation requests have been reviewed!"
                    android:textSize="13sp"
                    android:textStyle="italic"
                    android:textColor="#059669"
                    android:background="#ECFDF5"
                    android:visibility="gone" />

            </LinearLayout>

            <!-- Personal Reservations Section (ONLY VISIBLE FOR FACULTY & STUDENT ORGS) -->
            <LinearLayout
                android:id="@+id/layout_reservations_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible">

                <!-- Section Header with '>' Button -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:text="My Reservations"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="#111827" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_view_all_reservations"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:text="View All ➔"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#005A36" />

                </RelativeLayout>

                <!-- Horizontal Reservation Cards Carousel -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_user_reservations"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:listitem="@layout/item_user_reservation_card"
                    android:clipToPadding="false"
                    android:layout_marginBottom="24dp" />

                <!-- Empty State Message -->
                <TextView
                    android:id="@+id/tv_home_no_reservations"
                    android:layout_width="match_parent"
                    android:layout_height="80dp"
                    android:gravity="center"
                    android:text="No active reservations recorded for your account."
                    android:textSize="13sp"
                    android:textStyle="italic"
                    android:textColor="#6B7280"
                    android:background="@drawable/bg_edit_input"
                    android:layout_marginBottom="24dp"
                    android:visibility="gone" />

            </LinearLayout>

            <!-- Interactive Map Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Interactive Campus Map"
                android:textSize="22sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:textColor="#111827"
                android:layout_marginBottom="12dp" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_launch_map"
                android:layout_width="match_parent"
                android:layout_height="340dp"
                app:cardCornerRadius="20dp"
                app:cardBackgroundColor="#FFFFFF"
                app:strokeWidth="1.5dp"
                app:strokeColor="#005A36"
                app:cardElevation="4dp"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginBottom="24dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <!-- Live Mapbox Map Preview -->
                    <com.mapbox.maps.MapView
                        android:id="@+id/home_map_view"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                    <!-- Transparent click overlay so clicking the map preview launches full map -->
                    <View
                        android:id="@+id/view_map_overlay"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground" />

                    <!-- Expand Button on Top Right of the Map -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/btn_expand_map"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_alignParentTop="true"
                        android:layout_alignParentEnd="true"
                        android:layout_margin="12dp"
                        app:cardCornerRadius="20dp"
                        app:cardBackgroundColor="#FFFFFF"
                        app:cardElevation="8dp"
                        app:strokeWidth="0dp"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:src="@android:drawable/ic_menu_crop"
                            app:tint="#005A36"
                            android:contentDescription="Expand Map" />

                    </com.google.android.material.card.MaterialCardView>

                </RelativeLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </ScrollView>

    <!-- Bottom Navigation Bar Widget -->
    <include
        android:id="@+id/bottom_nav_bar"
        layout="@layout/layout_bottom_nav_bar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_alignParentBottom="true" />

</RelativeLayout>