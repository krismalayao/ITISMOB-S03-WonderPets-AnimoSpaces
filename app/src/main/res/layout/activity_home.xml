<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#005A36"
    tools:context=".ui.home.HomeActivity">

    <!-- Top Green Header Area -->
    <LinearLayout
        android:id="@+id/layout_home_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="28dp"
        android:paddingEnd="20dp"
        android:paddingBottom="20dp">

        <!-- User Info Row -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <View
                android:id="@+id/view_avatar"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_floor_selected"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="14dp" />

            <TextView
                android:id="@+id/tv_greeting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hey there,\nFirst Name!"
                android:textSize="22sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:textColor="#FFFFFF"
                android:layout_toEndOf="@id/view_avatar"
                android:layout_centerVertical="true" />

            <TextView
                android:id="@+id/tv_role_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Student"
                android:textSize="12sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:textColor="#005A36"
                android:background="#FFFFFF"
                android:paddingStart="16dp"
                android:paddingTop="6dp"
                android:paddingEnd="16dp"
                android:paddingBottom="6dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true" />

        </RelativeLayout>

    </LinearLayout>

    <!-- White Content Scroll Area -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/layout_home_header"
        android:layout_above="@+id/bottom_nav_bar"
        android:background="@drawable/bg_rounded_top_card"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Personal Reservations Section (ONLY VISIBLE FOR FACULTY & STUDENT ORGS) -->
            <LinearLayout
                android:id="@+id/layout_reservations_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="My Reservations"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="#111827"
                    android:layout_marginBottom="12dp" />

                <!-- Reservations Table Container -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="16dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:strokeWidth="1dp"
                    app:strokeColor="#10B981"
                    android:layout_marginBottom="24dp">

                    <LinearLayout
                        android:id="@+id/layout_table_rows"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!-- Table Header -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="36dp"
                            android:background="#005A36"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.2" android:text="Activity Name" android:textSize="10sp" android:textStyle="bold" android:fontFamily="sans-serif-medium" android:textColor="#FFFFFF" android:gravity="center" />
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Date" android:textSize="10sp" android:textStyle="bold" android:fontFamily="sans-serif-medium" android:textColor="#FFFFFF" android:gravity="center" />
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.1" android:text="Time" android:textSize="10sp" android:textStyle="bold" android:fontFamily="sans-serif-medium" android:textColor="#FFFFFF" android:gravity="center" />
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Venue" android:textSize="10sp" android:textStyle="bold" android:fontFamily="sans-serif-medium" android:textColor="#FFFFFF" android:gravity="center" />

                        </LinearLayout>

                        <!-- Empty State Message -->
                        <TextView
                            android:id="@+id/tv_home_no_reservations"
                            android:layout_width="match_parent"
                            android:layout_height="60dp"
                            android:gravity="center"
                            android:text="No reservations recorded for your account."
                            android:textSize="12sp"
                            android:textStyle="italic"
                            android:textColor="#6B7280"
                            android:visibility="gone" />

                        <!-- Dynamic Table Container for user rows -->
                        <LinearLayout
                            android:id="@+id/container_user_reservations"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- Interactive Map Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Interactive Campus Map"
                android:textSize="22sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:textColor="#111827"
                android:layout_marginBottom="12dp" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_launch_map"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                app:cardCornerRadius="20dp"
                app:cardBackgroundColor="#005A36"
                app:cardElevation="4dp"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginBottom="24dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageView
                        android:layout_width="90dp"
                        android:layout_height="90dp"
                        android:layout_centerInParent="true"
                        android:src="@android:drawable/ic_dialog_map"
                        app:tint="#FFFFFF"
                        android:contentDescription="Map Widget" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tap to open Interactive Campus Map 📍"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="#FFFFFF"
                        android:layout_alignParentBottom="true"
                        android:layout_centerHorizontal="true"
                        android:layout_marginBottom="16dp" />

                </RelativeLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </ScrollView>

    <!-- Bottom Navigation Bar Widget -->
    <include
        android:id="@+id/bottom_nav_bar"
        layout="@layout/layout_bottom_nav_bar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_alignParentBottom="true" />

</RelativeLayout>