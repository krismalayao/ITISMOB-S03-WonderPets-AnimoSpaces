<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    tools:context=".MainActivity">

    <!-- Top Header Card: Branding, Admin Portal, Search Bar & Category Filters -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_margin="12dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="6dp"
        app:cardBackgroundColor="#FFFFFF"
        app:strokeWidth="1.5dp"
        app:strokeColor="#005A36">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- Row 1: Brand Title & Admin Portal Button -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true">

                    <View
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:background="@drawable/bg_floor_selected"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:id="@+id/tv_app_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/app_name"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="#005A36" />

                </LinearLayout>

                <!-- Admin Portal Button (ONLY VISIBLE FOR ADMIN USERS) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_admin_portal"
                    style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="Admin"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    app:cornerRadius="18dp"
                    android:backgroundTint="#005A36"
                    android:textColor="#FFFFFF"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:visibility="gone"
                    tools:visibility="visible" />

            </RelativeLayout>

            <!-- Row 2: Search Bar with Clear Button -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="42dp"
                app:cardCornerRadius="21dp"
                app:cardBackgroundColor="#F4FBF7"
                app:strokeWidth="1dp"
                app:strokeColor="#005A36"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@android:drawable/ic_menu_search"
                        app:tint="#005A36"
                        android:contentDescription="Search Icon" />

                    <EditText
                        android:id="@+id/et_search"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@null"
                        android:hint="@string/search_buildings_rooms_hint"
                        android:textSize="13sp"
                        android:textColor="#1F2937"
                        android:textColorHint="#6B7280"
                        android:imeOptions="actionSearch"
                        android:inputType="text"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp" />

                    <ImageView
                        android:id="@+id/btn_clear_search"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@android:drawable/ic_menu_close_clear_cancel"
                        app:tint="#6B7280"
                        android:contentDescription="Clear Search"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true"
                        android:visibility="gone"
                        tools:visibility="visible" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Row 3: Category Quick-Filter Chips Carousel -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:layout_marginTop="8dp">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chip_group_search_category"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:singleSelection="true"
                    app:selectionRequired="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_cat_all"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="All"
                        android:textSize="11.5sp"
                        android:checked="true" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_cat_academic"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Academic"
                        android:textSize="11.5sp" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_cat_lab"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Laboratory"
                        android:textSize="11.5sp" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_cat_library"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Library"
                        android:textSize="11.5sp" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_cat_auditorium"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Auditorium"
                        android:textSize="11.5sp" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_cat_sports"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sports"
                        android:textSize="11.5sp" />

                </com.google.android.material.chip.ChipGroup>

            </HorizontalScrollView>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Mapbox View Container -->
    <com.mapbox.maps.MapView
        android:id="@+id/map_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/card_header"
        android:layout_above="@+id/bottom_nav_bar" />

    <!-- Search Results Cards Panel (Overlay over map during active search) -->
    <LinearLayout
        android:id="@+id/layout_search_results_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/card_header"
        android:layout_above="@+id/bottom_nav_bar"
        android:orientation="vertical"
        android:background="#FAFDFB"
        android:elevation="8dp"
        android:visibility="gone"
        tools:visibility="visible">

        <!-- Search Results Header Bar -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:paddingTop="10dp"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/tv_search_results_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                tools:text="Showing 10 buildings"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#005A36" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_toggle_map_view"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:text="View Map 🗺️"
                android:textSize="11sp"
                android:textColor="#005A36" />

        </RelativeLayout>

        <!-- Vertical Search Result Cards List -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_search_results_cards"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="16dp"
            tools:listitem="@layout/item_building_search_card" />

        <!-- Empty Search State -->
        <TextView
            android:id="@+id/tv_empty_search_results"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:gravity="center"
            android:text="No buildings, rooms, or amenities match your search."
            android:textSize="14sp"
            android:textColor="#9CA3AF"
            android:visibility="gone" />

    </LinearLayout>

    <!-- Floating Floor Level Selector Bar (Right side) -->
    <include
        android:id="@+id/include_floor_selector"
        layout="@layout/layout_floor_selector"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_above="@+id/rv_building_chips"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp" />

    <!-- Floating Recenter Camera FAB -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_recenter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@+id/include_floor_selector"
        android:layout_alignParentEnd="true"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="12dp"
        android:contentDescription="Recenter Map"
        app:fabSize="mini"
        app:tint="#005A36"
        app:backgroundTint="#FFFFFF"
        android:src="@android:drawable/ic_menu_compass" />

    <!-- Floating Horizontal Building Chips Carousel (Bottom) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_building_chips"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@+id/bottom_nav_bar"
        android:orientation="horizontal"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        tools:listitem="@layout/item_building_chip"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp"
        android:clipToPadding="false" />

    <!-- Shared Bottom Nav Bar -->
    <include
        android:id="@+id/bottom_nav_bar"
        layout="@layout/layout_bottom_nav_bar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_alignParentBottom="true" />

</RelativeLayout>