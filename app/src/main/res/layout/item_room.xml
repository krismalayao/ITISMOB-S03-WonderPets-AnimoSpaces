<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_room"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeWidth="1dp"
    app:strokeColor="#E5E7EB">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Room Code, Type, and Status Badge -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_alignParentStart="true">

                <TextView
                    android:id="@+id/tv_room_code"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="A0801"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#111827" />

                <TextView
                    android:id="@+id/tv_room_type"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="• Classroom"
                    android:textSize="14sp"
                    android:textColor="#6B7280"
                    android:layout_marginStart="8dp" />

            </LinearLayout>

            <TextView
                android:id="@+id/tv_room_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                tools:text="Available"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#15803D"
                android:background="@drawable/bg_status_available"
                android:paddingStart="10dp"
                android:paddingTop="4dp"
                android:paddingEnd="10dp"
                android:paddingBottom="4dp" />

        </RelativeLayout>

        <!-- Capacity & Schedule Summary -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/tv_room_capacity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="Capacity: 45 seats"
                android:textSize="13sp"
                android:textColor="#4B5563" />

        </LinearLayout>

        <TextView
            android:id="@+id/tv_schedule_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:text="Available - Free until 4:00 PM"
            android:textSize="13sp"
            android:textStyle="italic"
            android:textColor="#374151"
            android:layout_marginBottom="12dp" />

        <!-- Amenities Chips & Reserve Button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_amenities"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                tools:text="Projector, Aircon, Wi-Fi"
                android:textSize="12sp"
                android:textColor="#6B7280" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_reserve_room"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/reserve_room"
                android:textSize="12sp"
                app:cornerRadius="20dp"
                android:backgroundTint="#005A36"
                android:textColor="#FFFFFF" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>