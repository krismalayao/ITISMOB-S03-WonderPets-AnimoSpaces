<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_user_reservation_full"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeWidth="1.2dp"
    app:strokeColor="#005A36">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header: Venue & Status Badge -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp">

            <TextView
                android:id="@+id/tv_res_venue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:layout_toStartOf="@+id/tv_res_status"
                tools:text="A0801 • Andrew Gonzalez Hall"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#005A36"
                android:background="@drawable/bg_chip_code"
                android:paddingStart="8dp"
                android:paddingTop="4dp"
                android:paddingEnd="8dp"
                android:paddingBottom="4dp"
                android:ellipsize="end"
                android:singleLine="true" />

            <TextView
                android:id="@+id/tv_res_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                tools:text="APPROVED"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#15803D"
                android:background="@drawable/bg_status_available"
                android:paddingStart="10dp"
                android:paddingTop="4dp"
                android:paddingEnd="10dp"
                android:paddingBottom="4dp"
                android:layout_marginStart="8dp" />

        </RelativeLayout>

        <!-- Event Title -->
        <TextView
            android:id="@+id/tv_res_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:text="CSORG General Assembly"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#111827"
            android:maxLines="2"
            android:ellipsize="end"
            android:layout_marginBottom="8dp" />

        <!-- Date & Time info -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/tv_res_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="📅 Oct 24, 2025"
                android:textSize="12.5sp"
                android:textColor="#374151"
                android:layout_marginEnd="16dp" />

            <TextView
                android:id="@+id/tv_res_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="⏰ 2:00 PM - 4:00 PM"
                android:textSize="12.5sp"
                android:textColor="#374151" />

        </LinearLayout>

        <!-- Attendees & Purpose -->
        <TextView
            android:id="@+id/tv_res_attendees"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:text="👥 30 Attendees • Annual orientation meeting and project presentation."
            android:textSize="12sp"
            android:textColor="#6B7280"
            android:ellipsize="end"
            android:maxLines="2" />

        <!-- Export Calendar (.ics) Action -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_export_ical"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Export iCal (.ics)"
            android:textSize="12sp"
            android:textColor="#005A36"
            app:icon="@android:drawable/ic_menu_my_calendar"
            app:iconTint="#005A36"
            app:iconSize="16dp" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>