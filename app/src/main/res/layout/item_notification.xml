<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_notification"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="1dp"
    app:strokeWidth="1dp"
    app:strokeColor="#E2E8F0">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="14dp"
        android:gravity="center_vertical">

        <!-- Notification Type Icon -->
        <ImageView
            android:id="@+id/iv_notif_icon"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_floor_selected"
            android:padding="8dp"
            android:src="@android:drawable/ic_dialog_info"
            app:tint="#FFFFFF"
            android:contentDescription="Notification Icon"
            android:layout_marginEnd="12dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="2dp">

                <TextView
                    android:id="@+id/tv_notif_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="Reservation Approved! 🎉"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#111827"
                    android:layout_alignParentStart="true" />

                <TextView
                    android:id="@+id/tv_notif_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="1 hour ago"
                    android:textSize="11sp"
                    android:textColor="#9CA3AF"
                    android:layout_alignParentEnd="true" />

            </RelativeLayout>

            <TextView
                android:id="@+id/tv_notif_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                tools:text="Your request for A0802 (Andrew Gonzalez Hall) was approved by Admin."
                android:textSize="12sp"
                android:textColor="#4B5563" />

        </LinearLayout>

        <!-- Unread Badge Dot -->
        <View
            android:id="@+id/view_unread_dot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/bg_floor_selected"
            android:layout_marginStart="8dp"
            android:visibility="visible" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>