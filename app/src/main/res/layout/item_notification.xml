<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_notification"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="1dp"
    app:strokeWidth="1dp"
    app:strokeColor="#E2E8F0"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Top Header Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Notification Type Icon -->
            <ImageView
                android:id="@+id/iv_notif_icon"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_floor_selected"
                android:padding="8dp"
                android:src="@android:drawable/ic_dialog_info"
                app:tint="#FFFFFF"
                android:contentDescription="Notification Icon"
                android:layout_marginEnd="12dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="2dp">

                    <TextView
                        android:id="@+id/tv_notif_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="Reservation Approved! 🎉"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#111827"
                        android:layout_alignParentStart="true" />

                    <TextView
                        android:id="@+id/tv_notif_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="1 hour ago"
                        android:textSize="11sp"
                        android:textColor="#9CA3AF"
                        android:layout_alignParentEnd="true" />

                </RelativeLayout>

                <TextView
                    android:id="@+id/tv_notif_message"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    tools:text="Your request for A0802 (Andrew Gonzalez Hall) was approved by Admin."
                    android:textSize="12sp"
                    android:textColor="#4B5563"
                    android:maxLines="2"
                    android:ellipsize="end" />

            </LinearLayout>

            <!-- Expand / Collapse Arrow Icon -->
            <ImageView
                android:id="@+id/iv_notif_expand"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@android:drawable/arrow_down_float"
                app:tint="#005A36"
                android:layout_marginStart="6dp"
                android:contentDescription="Expand" />

            <!-- Unread Badge Dot -->
            <View
                android:id="@+id/view_unread_dot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/bg_floor_selected"
                android:layout_marginStart="8dp"
                android:visibility="visible" />

        </LinearLayout>

        <!-- EXPANDED NOTIFICATION CARD -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_notif_expanded"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:strokeWidth="1.5dp"
            app:strokeColor="#005A36"
            app:cardBackgroundColor="#F8FAFC"
            android:visibility="gone"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <!-- Expanded Card Title & Tag -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:id="@+id/tv_exp_card_type"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="NOTIFICATION DETAILS"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#005A36"
                        android:letterSpacing="0.05"
                        android:layout_alignParentStart="true" />

                    <TextView
                        android:id="@+id/tv_exp_card_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="STATUS ALERT"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="#15803D"
                        android:background="@drawable/bg_chip_code"
                        android:paddingStart="8dp"
                        android:paddingTop="2dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="2dp"
                        android:layout_alignParentEnd="true" />

                </RelativeLayout>

                <!-- Full Notification Message Body -->
                <TextView
                    android:id="@+id/tv_exp_card_message"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    tools:text="Your request for A0802 (Andrew Gonzalez Hall) was approved by Admin."
                    android:textSize="13sp"
                    android:textColor="#1F2937"
                    android:lineSpacingExtra="3dp"
                    android:layout_marginBottom="10dp" />

                <!-- Venue / Reservation Details (if available) -->
                <LinearLayout
                    android:id="@+id/layout_exp_reservation_specs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="#ECFDF5"
                    android:padding="10dp"
                    android:layout_marginTop="4dp"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <TextView
                        android:id="@+id/tv_exp_venue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        tools:text="📍 Venue: A0802 (Andrew Gonzalez Hall)"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#065F46"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/tv_exp_schedule"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        tools:text="📅 Schedule: Oct 15, 2026 | ⏰ 1:00 PM - 3:00 PM"
                        android:textSize="12sp"
                        android:textColor="#047857" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
