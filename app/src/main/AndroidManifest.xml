<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permissions required for Mapbox, Location, and Push Notifications -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AnimoSpaces">

        <activity
            android:name=".ui.auth.LoginActivity"
            android:exported="true"
            android:theme="@style/Theme.AnimoSpaces">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.auth.RegisterActivity"
            android:exported="false"
            android:label="Register Account" />

        <activity
            android:name=".ui.home.HomeActivity"
            android:exported="false"
            android:label="Animo Spaces Home" />

        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:windowSoftInputMode="adjustResize"
            android:label="Interactive Campus Map" />

        <activity
            android:name=".ui.profile.ProfileActivity"
            android:exported="false"
            android:label="My Profile" />

        <activity
            android:name=".ui.notifications.NotificationsActivity"
            android:exported="false"
            android:label="Notifications" />

        <activity
            android:name=".ui.dashboard.ReservationDashboardActivity"
            android:exported="false"
            android:label="Reservation Dashboard" />

        <activity
            android:name=".ui.admin.AdminActivity"
            android:exported="false"
            android:label="Reservation Management (Admin)" />
    </application>

</manifest>